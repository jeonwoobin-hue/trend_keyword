# .streamlit/secrets.toml 템플릿 — 실제 값을 채운 secrets.toml은 git에 커밋하지 않는다(.gitignore 참고).
# 로컬에서: 이 파일을 .streamlit/secrets.toml로 복사한 뒤 아래 값을 Supabase 대시보드
# (Project Settings → API)에서 확인해 채운다.

[supabase]
url = "https://xxxxxxxxxxxx.supabase.co"
anon_key = "여기에 anon public key"
service_role_key = "여기에 service_role key — worker/관리자 전용, 클라이언트 코드에 노출 금지"
